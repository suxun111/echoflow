{
  "name": "@online-learning/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @online-learning/database test:prepare",
    "test": "vitest run --no-file-parallelism",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@online-learning/config": "workspace:*",
    "@online-learning/contracts": "workspace:*",
    "@online-learning/database": "workspace:*",
    "@online-learning/storage": "workspace:*",
    "cookie": "1.0.2",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.15.32",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
