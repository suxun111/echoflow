NODE_ENV=development
API_PORT=3001
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql://online_learning:online_learning@localhost:5432/online_learning
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MEDIA_QUEUE_NAME=online-learning-media
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=online_learning
MINIO_SECRET_KEY=online_learning_secret
MINIO_BUCKET=online-learning
# Host-run Worker: http://127.0.0.1:8001. Docker Desktop Worker with the
# separately deployed local MOSS Compose stack: http://host.docker.internal:8001.
# A shared production Compose network should use its MOSS service name instead.
MOSS_BASE_URL=http://127.0.0.1:8001
MOSS_API_TOKEN=
MOSS_REQUEST_TIMEOUT_MS=10000
MOSS_MAX_RETRIES=2
MOSS_RETRY_DELAY_MS=500
MOSS_POLL_INTERVAL_MS=5000
