NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://online_learning:online_learning@localhost:5432/echoflow
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=online_learning
MINIO_SECRET_KEY=online_learning_secret
MINIO_BUCKET=online-learning
UPLOAD_MAX_FILE_BYTES=8589934592
UPLOAD_USER_QUOTA_BYTES=21474836480
UPLOAD_PART_SIZE_BYTES=33554432
UPLOAD_SESSION_TTL_SECONDS=604800
STORAGE_SIGNED_URL_TTL_SECONDS=900
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MOSS_ENABLED=false
MOSS_MODEL_VERSION=moss-default
MOSS_REQUEST_TIMEOUT_MS=30000
MOSS_JOB_TIMEOUT_SECONDS=21600
MOSS_POLL_INTERVAL_SECONDS=30
MOSS_MAX_ATTEMPTS=5
MOSS_CHUNK_TARGET_SECONDS=600
MOSS_CHUNK_OVERLAP_SECONDS=2
MOSS_AUDIO_URL_TTL_SECONDS=900
MOSS_CALLBACK_MAX_AGE_SECONDS=300
# Enabling MOSS also requires MOSS_BASE_URL, MOSS_API_TOKEN,
# MOSS_CALLBACK_SECRET and a public MOSS_CALLBACK_PUBLIC_URL.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-another-32-random-characters
OTP_HMAC_SECRET=replace-with-a-third-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_SESSION_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MIN_REQUEST_INTERVAL_SECONDS=60
AUTH_EXPOSE_TEST_OTP=true
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173
VITE_API_URL=/api/v1
