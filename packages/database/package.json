  "optionalDependencies": { "@prisma/client": "6.10.1", "prisma": "6.10.1" },
  "devDependencies": { "@types/node": "^22.15.32", "tsx": "^4.20.3", "typescript": "^5.8.3", "vitest": "^3.2.4" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
