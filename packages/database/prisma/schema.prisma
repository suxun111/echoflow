generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum OtpPurpose {
  LOGIN
}

enum SourceType {
  PERSONAL
  WORKFLOW
}

enum UploadStatus {
  CREATED
  UPLOADING
  VERIFYING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum MediaAssetStatus {
  PROCESSING_PLAYBACK
  PLAYABLE
  FAILED
  DELETING
  DELETED
}

enum MediaObjectKind {
  ORIGINAL
  PLAYBACK
  NORMALIZED_AUDIO
  AUDIO_CHUNK
  ASR_RAW
  HANDOFF_AUDIO
  ALIGNMENT_RAW
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  VALIDATING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProcessingStage {
  UPLOAD_VERIFIED
  PROBING
  PLAYBACK_READY
  AUDIO_EXTRACTING
  CHUNKING
  TRANSCRIBING
  HANDOFF_EVIDENCING
  MERGING
  CUE_SEGMENTING
  VALIDATING
  TRANSCRIPT_READY
  COURSE_READY
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum TranscriptStatus {
  BUILDING
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum LessonStatus {
  PROCESSING
  READY
  ARCHIVED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  phone              String              @unique @db.VarChar(32)
  displayName        String              @db.VarChar(120)
  role               UserRole            @default(LEARNER)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  refreshSessions    RefreshSession[]
  uploadSessions     UploadSession[]
  mediaAssets        MediaAsset[]
  privateLessons     PrivateLesson[]
  learningProgresses LearningProgress[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[]
  processingRuns     ProcessingRun[]

  @@index([status])
  @@index([role])
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  phone       String     @db.VarChar(32)
  purpose     OtpPurpose @default(LOGIN)
  codeHash    String     @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  requestId   String?    @db.VarChar(128)
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model RefreshSession {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  familyId        String          @db.Uuid
  tokenHash       String          @unique @db.Char(64)
  expiresAt       DateTime
  rotatedAt       DateTime?
  revokedAt       DateTime?
  replacedById    String?         @unique @db.Uuid
  lastUsedAt      DateTime?
  userAgentHash   String?         @db.Char(64)
  ipHash          String?         @db.Char(64)
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement     RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedSession RefreshSession? @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
}

model UploadSession {
  id               String       @id @default(uuid()) @db.Uuid
  ownerId          String       @db.Uuid
  sourceType       SourceType   @default(PERSONAL)
  status           UploadStatus @default(CREATED)
  originalName     String       @db.VarChar(512)
  title            String       @default("Untitled video") @db.VarChar(300)
  contentType      String       @db.VarChar(128)
  sizeBytes        BigInt
  fileFingerprint  String?      @db.Char(64)
  bucket           String       @default("online-learning") @db.VarChar(255)
  objectKey        String       @unique @db.VarChar(1024)
  providerUploadId String?      @db.VarChar(512)
  partSizeBytes    BigInt
  expiresAt        DateTime
  completedAt      DateTime?
  abortedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parts            UploadPart[]
  mediaAsset       MediaAsset?

  @@unique([id, ownerId])
  @@index([ownerId, status])
  @@index([expiresAt])
}

model UploadPart {
  id              String        @id @default(uuid()) @db.Uuid
  uploadSessionId String        @db.Uuid
  partNumber      Int
  sizeBytes       BigInt
  etag            String        @db.VarChar(512)
  checksumSha256  String?       @db.Char(64)
  createdAt       DateTime      @default(now())
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, partNumber])
}

model MediaAsset {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerId            String              @db.Uuid
  uploadSessionId    String?             @unique @db.Uuid
  sourceType         SourceType          @default(PERSONAL)
  status             MediaAssetStatus    @default(PROCESSING_PLAYBACK)
  title              String              @db.VarChar(300)
  originalName       String              @db.VarChar(512)
  durationMs         Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadSession      UploadSession?      @relation(fields: [uploadSessionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  objects            MediaObject[]
  processingRuns     ProcessingRun[]
  transcriptVersions TranscriptVersion[]
  privateLesson      PrivateLesson?

  @@unique([id, ownerId])
  @@unique([uploadSessionId, ownerId])
  @@index([ownerId, status, createdAt])
}

model MediaObject {
  id             String          @id @default(uuid()) @db.Uuid
  mediaAssetId   String          @db.Uuid
  kind           MediaObjectKind
  bucket         String          @db.VarChar(255)
  objectKey      String          @db.VarChar(1024)
  versionId      String?         @db.VarChar(512)
  contentType    String          @db.VarChar(128)
  sizeBytes      BigInt
  checksumSha256 String?         @db.Char(64)
  etag           String?         @db.VarChar(512)
  metadata       Json?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  purgedAt       DateTime?
  mediaAsset     MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey, versionId])
  @@index([mediaAssetId, kind])
}

model ProcessingRun {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @db.Uuid
  mediaAssetId    String            @db.Uuid
  pipelineVersion String            @db.VarChar(128)
  activePlanRevision Int             @default(0)
  pendingPlanRevision Int?
  repairPlan      Json?
  status          ProcessingStatus  @default(QUEUED)
  stage           ProcessingStage   @default(UPLOAD_VERIFIED)
  attempt         Int               @default(0)
  requestId       String?           @db.VarChar(128)
  errorCode       String?           @db.VarChar(128)
  errorDetail     Json?
  leaseOwner      String?           @db.VarChar(255)
  leaseExpiresAt  DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset        @relation(fields: [mediaAssetId, ownerId], references: [id, ownerId], onDelete: Cascade)
  chunks          ProcessingChunk[]
  handoffs        ProcessingHandoff[]
  transcriptVersions TranscriptVersion[]

  @@unique([mediaAssetId, pipelineVersion])
  @@unique([id, mediaAssetId])
  @@index([ownerId, status])
  @@index([status, leaseExpiresAt])
  @@index([mediaAssetId, createdAt])
}

model ProcessingChunk {
  id              String           @id @default(uuid()) @db.Uuid
  processingRunId String           @db.Uuid
  planRevision    Int              @default(0)
  chunkIndex      Int
  startMs         Int
  endMs           Int
  status          ProcessingStatus @default(QUEUED)
  attempt         Int              @default(0)
  idempotencyKey  String           @unique @db.VarChar(512)
  modelVersion    String           @db.VarChar(128)
  externalJobId   String?          @unique @db.VarChar(512)
  inputObjectKey  String           @db.VarChar(1024)
  inputVersionId  String?          @db.VarChar(512)
  inputChecksum   String?          @db.Char(64)
  resultObjectKey String?          @db.VarChar(1024)
  resultVersionId String?          @db.VarChar(512)
  resultChecksum  String?          @db.Char(64)
  wordCount       Int              @default(0)
  errorDetail     Json?
  leaseOwner      String?          @db.VarChar(255)
  leaseExpiresAt  DateTime?
  nextPollAt      DateTime?
  submittedAt     DateTime?
  externalUpdatedAt DateTime?
  externalCancelledAt DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  errorCode       String?          @db.VarChar(128)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processingRun   ProcessingRun    @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  callbackReceipts MossCallbackReceipt[]
  handoffsAsPrevious ProcessingHandoff[] @relation("HandoffPreviousChunk")
  handoffsAsNext     ProcessingHandoff[] @relation("HandoffNextChunk")

  @@unique([processingRunId, planRevision, chunkIndex])
  @@unique([id, processingRunId])
  @@index([processingRunId, chunkIndex, planRevision])
  @@index([status, updatedAt])
  @@index([status, nextPollAt])
}

model MossCallbackReceipt {
  eventId          String           @id @db.VarChar(255)
  nonce            String           @unique @db.VarChar(255)
  processingChunkId String?         @db.Uuid
  externalJobId    String           @db.VarChar(512)
  idempotencyKey   String           @db.VarChar(512)
  payloadHash      String           @db.Char(64)
  externalStatus   String           @db.VarChar(64)
  occurredAt       DateTime
  receivedAt       DateTime         @default(now())
  processedAt      DateTime?
  processingChunk ProcessingChunk? @relation(fields: [processingChunkId], references: [id], onDelete: SetNull)

  @@index([externalJobId, receivedAt])
  @@index([processingChunkId, receivedAt])
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @db.VarChar(128)
  aggregateId    String       @db.VarChar(128)
  eventType      String       @db.VarChar(128)
  idempotencyKey String       @unique @db.VarChar(255)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  publishedAt    DateTime?
  lastError      String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model TranscriptVersion {
  id            String           @id @default(uuid()) @db.Uuid
  mediaAssetId  String           @db.Uuid
  processingRunId String         @unique @db.Uuid
  version       Int
  planRevision  Int              @default(0)
  hTotal        Int              @default(0)
  hUnique       Int              @default(0)
  hR1           Int              @default(0)
  hUnresolved   Int              @default(0)
  hSegment      Int              @default(0)
  hProviderWord Int              @default(0)
  hAlignment    Int              @default(0)
  language      String           @default("en") @db.VarChar(16)
  pipelineVersion String         @db.VarChar(128)
  modelVersion String            @db.VarChar(128)
  status        TranscriptStatus @default(BUILDING)
  durationMs    Int
  cueCount      Int              @default(0)
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  mediaAsset    MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  processingRun ProcessingRun    @relation(fields: [processingRunId, mediaAssetId], references: [id, mediaAssetId], onDelete: Restrict)
  cues          SubtitleCue[]
  privateLesson PrivateLesson?

  @@unique([mediaAssetId, version])
  @@unique([id, mediaAssetId])
  @@index([mediaAssetId, status])
}

model SubtitleCue {
  id                  String             @id @default(uuid()) @db.Uuid
  transcriptVersionId String             @db.Uuid
  order               Int
  startMs             Int
  endMs               Int
  text                String
  words               Json
  transcriptVersion   TranscriptVersion  @relation(fields: [transcriptVersionId], references: [id], onDelete: Cascade)
  currentProgresses   LearningProgress[]

  @@unique([transcriptVersionId, order])
  @@unique([id, transcriptVersionId])
  @@index([transcriptVersionId, startMs])
}

model PrivateLesson {
  id                  String             @id @default(uuid()) @db.Uuid
  ownerId             String             @db.Uuid
  mediaAssetId        String             @unique @db.Uuid
  transcriptVersionId String?            @unique @db.Uuid
  title               String             @db.VarChar(300)
  status              LessonStatus       @default(PROCESSING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset         @relation(fields: [mediaAssetId, ownerId], references: [id, ownerId], onDelete: Cascade)
  transcriptVersion   TranscriptVersion? @relation(fields: [transcriptVersionId, mediaAssetId], references: [id, mediaAssetId], onDelete: Restrict)
  learningUnits       LearningUnit[]
  progresses          LearningProgress[] @relation("LessonProgress")
  currentProgresses   LearningProgress[] @relation("ProgressTranscript")

  @@unique([id, ownerId])
  @@unique([mediaAssetId, ownerId])
  @@unique([transcriptVersionId, mediaAssetId])
  @@unique([id, transcriptVersionId])
  @@index([ownerId, status, updatedAt])
}

model LearningUnit {
  id                String             @id @default(uuid()) @db.Uuid
  lessonId          String             @db.Uuid
  order             Int
  startMs           Int
  endMs             Int
  firstCueOrder     Int
  lastCueOrder      Int
  lesson            PrivateLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  currentProgresses LearningProgress[]

  @@unique([lessonId, order])
  @@unique([id, lessonId])
}

model LearningProgress {
  id                         String         @id @default(uuid()) @db.Uuid
  ownerId                    String         @db.Uuid
  lessonId                   String         @db.Uuid
  currentUnitId              String?        @db.Uuid
  currentTranscriptVersionId String?        @db.Uuid
  currentCueId               String?        @db.Uuid
  positionMs                 Int            @default(0)
  completedCueIds            Json
  updatedAt                  DateTime       @updatedAt
  owner                      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lesson                     PrivateLesson  @relation("LessonProgress", fields: [lessonId, ownerId], references: [id, ownerId], onDelete: Cascade)
  currentUnit                LearningUnit?  @relation(fields: [currentUnitId, lessonId], references: [id, lessonId], onDelete: Restrict)
  currentTranscript          PrivateLesson? @relation("ProgressTranscript", fields: [lessonId, currentTranscriptVersionId], references: [id, transcriptVersionId], onDelete: Restrict)
  currentCue                 SubtitleCue?   @relation(fields: [currentCueId, currentTranscriptVersionId], references: [id, transcriptVersionId], onDelete: Restrict)

  @@unique([ownerId, lessonId])
  @@index([lessonId])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @db.VarChar(128)
  resourceId   String?  @db.VarChar(128)
  requestId    String   @db.VarChar(128)
  metadata     Json
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  scope          String   @db.VarChar(128)
  key            String   @db.VarChar(255)
  requestHash    String   @db.Char(64)
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, scope, key])
  @@index([expiresAt])
}

// ---- G3 v2 deterministic foundation (Route B handoff evidence) ----

model ProcessingHandoff {
  id                  String    @id @default(uuid()) @db.Uuid
  processingRunId     String    @db.Uuid
  planRevision        Int       @default(0)
  logicalHandoffIndex Int
  previousChunkId     String    @db.Uuid
  nextChunkId         String    @db.Uuid
  status              String    @default("PENDING") @db.VarChar(32)
  attempt             Int       @default(0)
  errorCode           String?   @db.VarChar(128)
  leaseOwner          String?   @db.VarChar(255)
  leaseExpiresAt      DateTime?
  cancelledAt         DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  processingRun       ProcessingRun    @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  previousChunk       ProcessingChunk  @relation("HandoffPreviousChunk", fields: [previousChunkId, processingRunId], references: [id, processingRunId], onDelete: Restrict)
  nextChunk           ProcessingChunk  @relation("HandoffNextChunk", fields: [nextChunkId, processingRunId], references: [id, processingRunId], onDelete: Restrict)
  assessment          HandoffAssessment?
  alignmentJob        AlignmentJob?
  finalEvidence       HandoffEvidence?

  @@unique([processingRunId, planRevision, logicalHandoffIndex])
  @@unique([id, processingRunId])
  @@index([processingRunId, status])
  @@index([status, leaseExpiresAt])
}

model HandoffAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  handoffId     String   @unique @db.Uuid
  decision      String   @db.VarChar(32)
  decisionCode  String   @db.VarChar(128)
  evidenceType  String   @db.VarChar(64)
  inputChecksum String   @db.Char(64)
  windowStartMs Int
  windowEndMs   Int
  metadata      Json?
  createdAt     DateTime @default(now())
  handoff       ProcessingHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([handoffId, decision])
}

model AlignmentJob {
  id                  String   @id @default(uuid()) @db.Uuid
  handoffId           String   @unique @db.Uuid
  idempotencyKey      String   @unique @db.VarChar(512)
  correlationHandle   String   @unique @db.VarChar(255)
  status              String   @default("PENDING") @db.VarChar(32)
  attempt             Int      @default(0)
  externalJobId       String?  @unique @db.VarChar(512)
  windowStartMs       Int
  windowEndMs         Int
  methodDigest        String   @db.Char(64)
  modelDigest         String   @db.Char(64)
  configDigest        String   @db.Char(64)
  errorCode           String?  @db.VarChar(128)
  leaseOwner          String?  @db.VarChar(255)
  leaseExpiresAt      DateTime?
  nextPollAt          DateTime?
  nextAttemptAt       DateTime?
  submittedAt         DateTime?
  externalUpdatedAt   DateTime?
  externalCancelledAt DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  handoff             ProcessingHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([status, nextPollAt])
  @@index([status, nextAttemptAt])
}

model HandoffEvidence {
  id                        String   @id @default(uuid()) @db.Uuid
  handoffId                 String   @unique @db.Uuid
  planRevision              Int
  logicalHandoffIndex       Int
  decision                  String   @db.VarChar(32)
  decisionCode              String   @db.VarChar(128)
  evidenceType              String   @db.VarChar(64)
  schemaVersion             String   @db.VarChar(64)
  pipelineVersion           String   @db.VarChar(128)
  previousChunkId           String   @db.Uuid
  nextChunkId               String   @db.Uuid
  normalizedAudioVersionId  String?  @db.VarChar(512)
  normalizedAudioChecksum   String?  @db.Char(64)
  previousAsrObjectKey      String   @db.VarChar(1024)
  previousAsrVersionId      String?  @db.VarChar(512)
  previousAsrChecksum       String?  @db.Char(64)
  nextAsrObjectKey          String   @db.VarChar(1024)
  nextAsrVersionId          String?  @db.VarChar(512)
  nextAsrChecksum           String?  @db.Char(64)
  rawObjectKey              String?  @db.VarChar(1024)
  rawVersionId              String?  @db.VarChar(512)
  rawChecksum               String?  @db.Char(64)
  methodProvider            String   @db.VarChar(128)
  methodVersion             String   @db.VarChar(128)
  modelRevision             String?  @db.VarChar(128)
  alignmentPolicyDigest     String?  @db.Char(64)
  windowStartMs             Int
  windowEndMs               Int
  candidateCount            Int      @default(0)
  anchorCount               Int      @default(0)
  coverageMs                Int      @default(0)
  proofKeyVersion           String   @db.VarChar(64)
  proofDigest               String   @db.Char(64)
  verifiedAt                DateTime?
  createdAt                 DateTime @default(now())
  handoff                   ProcessingHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@unique([id, handoffId])
  @@index([handoffId, planRevision])
}
