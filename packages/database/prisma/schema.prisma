generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  EDITOR
  ADMIN
}

enum AssetStatus {
  CANDIDATE
  RIGHTS_REVIEW
  APPROVED
  PROCESSING
  READY
  PUBLISHED
  REJECTED
  ARCHIVED
  FAILED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum JobType {
  TRANSCODE
  TRANSCRIBE
  TRANSLATE
  SEGMENT
  PUBLISH
}

enum JobStatus {
  QUEUED
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
}

enum VocabularyTermType {
  WORD
  PHRASE
}

enum VocabularyTranslationSource {
  VOLCENGINE
  LOCAL_FALLBACK
  NONE
}

enum VocabularyTranslationStatus {
  TRANSLATED
  PENDING
  RETRYABLE_FAILED
  PERMANENT_FAILED
}

model User {
  id             String             @id @default(cuid())
  phone          String             @unique
  displayName    String
  role           UserRole           @default(LEARNER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  progresses     LearningProgress[]
  favorites      Favorite[]
  vocabulary     VocabularyItem[]
  recordings     Recording[]
  uploads        Upload[]
  reviews        AuthorizationReview[]
}

model VideoAsset {
  id             String                @id @default(cuid())
  sourcePlatform String?
  sourceUrl      String?
  title          String
  creator        String
  coverUrl       String
  coverStorageKey String?
  storageKey     String?
  durationMs     Int
  category       String
  accent         String
  level          String
  status         AssetStatus           @default(CANDIDATE)
  rightsNote     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lesson         Lesson?
  reviews        AuthorizationReview[]
  uploads        Upload[]
}

model AuthorizationReview {
  id          String         @id @default(cuid())
  assetId     String
  reviewerId  String
  decision    ReviewDecision
  note        String         @default("")
  createdAt   DateTime       @default(now())
  asset       VideoAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewer    User           @relation(fields: [reviewerId], references: [id])
}

model Lesson {
  id          String             @id @default(cuid())
  videoId     String             @unique
  title       String
  description String             @default("")
  publishedAt DateTime?
  video       VideoAsset         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  cues        SubtitleCue[]
  progresses  LearningProgress[]
  favorites   Favorite[]
  vocabulary  VocabularyItem[]
  vocabularyTerms CourseVocabulary[]
  recordings  Recording[]
}

model SubtitleCue {
  id         String           @id @default(cuid())
  lessonId   String
  order      Int
  startMs    Int
  endMs      Int
  english    String
  chinese    String           @default("")
  speaker    String?
  keywords   Json
  reviewed   Boolean          @default(false)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary VocabularyItem[]
  vocabularyTerms CourseVocabulary[]
  recordings Recording[]
  @@unique([lessonId, order])
}

model LearningProgress {
  id               String   @id @default(cuid())
  userId           String
  lessonId         String
  currentCueId     String?
  completedCueIds  Json
  positionMs       Int      @default(0)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model VocabularyItem {
  id        String       @id @default(cuid())
  userId    String
  lessonId  String
  cueId     String?
  word      String
  meaning   String
  mastery   Int          @default(0)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cue       SubtitleCue? @relation(fields: [cueId], references: [id], onDelete: SetNull)
}

model CourseVocabulary {
  id                   String                       @id @default(cuid())
  lessonId             String
  cueId                String?
  word                 String
  normalizedWord       String
  termType             VocabularyTermType
  sourceSentence       String
  translation          String                       @default("")
  translationSource    VocabularyTranslationSource @default(NONE)
  translationStatus    VocabularyTranslationStatus @default(PENDING)
  translationErrorCode String?
  translatedAt         DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  lesson               Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cue                  SubtitleCue?                 @relation(fields: [cueId], references: [id], onDelete: SetNull)

  @@unique([lessonId, normalizedWord])
  @@index([lessonId])
}

model Recording {
  id         String       @id @default(cuid())
  userId     String
  lessonId   String
  cueId      String?
  storageKey String
  durationMs Int?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cue        SubtitleCue? @relation(fields: [cueId], references: [id], onDelete: SetNull)
}

model Upload {
  id              String          @id @default(cuid())
  userId          String
  videoAssetId    String?
  originalName    String
  storageKey      String
  contentType     String          @default("video/mp4")
  sizeBytes       Int             @default(0)
  rightsConfirmed Boolean
  private         Boolean         @default(true)
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoAsset      VideoAsset?      @relation(fields: [videoAssetId], references: [id])
  jobs            ProcessingJob[]
}

model ProcessingJob {
  id        String    @id @default(cuid())
  uploadId  String
  type      JobType
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  attempts  Int       @default(0)
  error     String?
  payload   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  upload    Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}
